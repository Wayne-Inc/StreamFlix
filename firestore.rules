rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USER DOCUMENTS (root collection)
    // ============================================
    match /users/{userId} {
      // Users can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ============================================
      // SUB-COLLECTION: users/{userId}/profiles/{profileId}
      // ============================================
      match /profiles/{profileId} {
        // Users can read/delete their own profiles.
        // NOTE: `allow read, write` used to sit next to the validated rule below.
        // Firestore ORs `allow` statements, so the strict rule was dead code.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Fields validation on create/update
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name', 'color', 'kids', 'avatarUrl', 'pinHash', 'createdAt', 'updatedAt', 'userId'])
          && request.resource.data.userId == request.auth.uid
          && (request.resource.data.name is string && request.resource.data.name.size() <= 50)
          && (request.resource.data.color is string)
          && (request.resource.data.kids is bool)
          && (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string)
          && (!('pinHash' in request.resource.data) || request.resource.data.pinHash is string);
      }

      // ============================================
      // OTHER SUB-COLLECTIONS (legacy per-user data)
      // Owners may read and delete their own data. Writes are validated by
      // the dedicated top-level collection rules below.
      // ============================================
      match /{subcollection}/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ============================================
    // CONTINUE WATCHING
    // Doc ID format: {uid}_{profileId}_{movieId} or {uid}_{profileId}_{movieId}:S{season}E{episode}
    // ============================================
    match /continue_watching/{docId} {
      allow read, write: if request.auth != null
        && docId.matches('^[^_]+_[^_]+_.*$')
        && docId.split('_')[0] == request.auth.uid;

      // Owners may list and delete their own documents (account deletion).
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Validate fields on write
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.movieId is string
        && request.resource.data.progress is number
        && request.resource.data.duration is number
        && request.resource.data.updatedAt is number;
    }

    // ============================================
    // WATCH HISTORY
    // Doc ID format: {uid}_{profileId}_{movieId}
    // ============================================
    match /watch_history/{docId} {
      allow read, write: if request.auth != null
        && docId.matches('^[^_]+_[^_]+_.*$')
        && docId.split('_')[0] == request.auth.uid;

      // Owners may list and delete their own documents (account deletion).
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.movieId is string
        && request.resource.data.watchedAt is number;

      // Allow delete for clear history
      allow delete: if request.auth != null
        && docId.matches('^[^_]+_[^_]+_.*$')
        && docId.split('_')[0] == request.auth.uid;
    }

    // ============================================
    // MY LIST
    // Doc ID format: {uid}_{profileId}_{movieId}
    // ============================================
    match /my_list/{docId} {
      allow read, write: if request.auth != null
        && docId.matches('^[^_]+_[^_]+_.*$')
        && docId.split('_')[0] == request.auth.uid;

      // Owners may list and delete their own documents (account deletion).
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.movieId is string
        && request.resource.data.addedAt is number
        && request.resource.data.movie is map;
    }

    // ============================================
    // FCM TOKENS (for push notifications)
    // Doc ID = token
    // ============================================
    match /fcm_tokens/{token} {
      // Users can create/update their own tokens
      allow create, update: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.device_id is string
        && request.resource.data.platform is string;

      // Users can delete their own tokens (sign out / account deletion)
      allow delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      // Users can read their own tokens (for debugging)
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;
    }

    // ============================================
    // RELEASE NOTIFICATIONS
    // Doc ID format: {userId}_{movieId}
    // ============================================
    match /release_notifications/{docId} {
      allow read, write: if request.auth != null
        && docId.matches('^[^_]+_.*$')
        && docId.split('_')[0] == request.auth.uid;

      allow create, update: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.movie_id is string
        && request.resource.data.title is string
        && request.resource.data.release_date is string;
    }

    // ============================================
    // USER DEVICES
    // Doc ID = device_id
    // ============================================
    match /user_devices/{deviceId} {
      // Users can create/update their own device info
      allow create, update: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.device_id == deviceId
        && request.resource.data.device_label is string
        && request.resource.data.browser is string
        && request.resource.data.os is string;

      // Users can delete their own device records
      allow delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      // Users can read their own devices
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;
    }

    // ============================================
    // SESSIONS
    // Active watch sessions
    // ============================================
    match /sessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.deviceId is string
        && request.resource.data.movieId is string
        && request.resource.data.profileId is string;

      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // PROFILES (root collection - legacy/simple)
    // Used for avatar sync and VIP check
    // ============================================
    match /profiles/{userId} {
      // Users can read/delete their own profile.
      // NOTE: the validated rule below was previously OR-ed away by a blanket
      // `allow read, write`, so it never actually ran.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['avatar_url', 'display_name', 'show_google_pfp', 'updated_at'])
        && (!('avatar_url' in request.resource.data) || request.resource.data.avatar_url is string)
        && (!('display_name' in request.resource.data) || request.resource.data.display_name is string)
        && (!('show_google_pfp' in request.resource.data) || request.resource.data.show_google_pfp is bool);
    }

    // ============================================
    // MOVIE SOURCES (root collection)
    // Read-only catalog of playable sources, written by admin tooling.
    // Without this rule the catch-all below denies every read and the app
    // silently gets `null` back from getVideoSource()/listVideoSources().
    // ============================================
    match /movie_sources/{tmdbId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================
    // VIP (root collection)
    // Read-only for users, admin write
    // ============================================
    match /vip/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Admin write handled via Admin SDK / Cloud Functions
      allow write: if false;
    }

    // ============================================
    // DENY ALL OTHER ACCESS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}