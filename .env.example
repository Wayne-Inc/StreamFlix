# Gmail SMTP settings for sending StreamFlix auth emails.
# Copy this to .env for local testing, and paste the same values into
# Vercel (Settings -> Environment Variables) for Production + Preview.

# Gmail SMTP server
SMTP_HOST="smtp.gmail.com"

# 465 = implicit TLS (with SMTP_SECURE=true), 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT="465"

# true for port 465, false for port 587
SMTP_SECURE="true"

# Your full Gmail address
SMTP_USER="you@gmail.com"

# A 16-character Gmail APP PASSWORD (NOT your normal Gmail password).
# Requires 2-Step Verification on the account:
#   https://myaccount.google.com/apppasswords
SMTP_PASS="abcd efgh ijkl mnop"

# Sender shown in the email. Gmail only lets you send as your own address.
SMTP_FROM="StreamFlix <you@gmail.com>"
