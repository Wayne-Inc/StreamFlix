# =============================================================================
# StreamFlix Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Client-side variables MUST be prefixed with VITE_ for Vite to inline them
# Server-only secrets go in Vercel/Firebase Project Settings, NOT in this file
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_VAPID_KEY="your-web-push-vapid-key"          # For push notifications
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"

# Firebase Admin SDK (SERVER-ONLY - never prefix with VITE_)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# TMDB API (Required)
# -----------------------------------------------------------------------------
# Get from: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"              # Server-side (v3 API)
VITE_TMDB_API_KEY="your-tmdb-api-key"         # Client-side (v4 Bearer token)

# -----------------------------------------------------------------------------
# NVIDIA NIM API (Optional - for AI Recommendations)
# -----------------------------------------------------------------------------
# Get from: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY="your-nvidia-api-key"          # SERVER-ONLY

# -----------------------------------------------------------------------------
# SITE CONFIGURATION
# -----------------------------------------------------------------------------
VITE_SITE_URL="https://streamflix.dpdns.org"  # Your production URL
CRON_SECRET="your-random-cron-secret"         # For /api/release-notifications-cron (SERVER)

# -----------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (Optional - Bot protection on auth forms)
# -----------------------------------------------------------------------------
# Get from: https://dash.cloudflare.com/ → Turnstile → Create site
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAFZsNJpxbMe3Icjp"
TURNSTILE_SECRET_KEY="0x4AAAAAAFZsNCKatyHZgeq1mgRHGTeOfBU"  # SERVER-ONLY

# -----------------------------------------------------------------------------
# FIREBASE APP CHECK (Optional - reCAPTCHA v3 for API abuse prevention)
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/recaptcha → v3
VITE_APP_CHECK_SITE_KEY="your-recaptcha-v3-site-key"

# -----------------------------------------------------------------------------
# FIREBASE EMULATOR (Development only)
# -----------------------------------------------------------------------------
# Set to "1" to enable local Firebase emulators
VITE_FIREBASE_EMULATOR="0"
VITE_FIREBASE_EMULATOR_HOST="127.0.0.1"

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"      # Google Analytics 4
# VITE_VERCEL_ANALYTICS_ID=""                 # Vercel Analytics

# =============================================================================
# QUICK START CHECKLIST
# =============================================================================
# [ ] Copy this file: cp .env.example .env.local
# [ ] Fill in all REQUIRED values (marked with ✅ above)
# [ ] Add SERVER-ONLY secrets to Vercel Dashboard → Settings → Environment Variables
# [ ] Run: npm run dev
# =============================================================================